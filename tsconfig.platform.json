{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "target": "ES2017"
  },
  "include": [
    "src/components/Analytics.tsx",
    "src/components/ads/AdSenseLoader.tsx",
    "src/components/analytics/**/*.ts",
    "src/components/analytics/**/*.tsx",
