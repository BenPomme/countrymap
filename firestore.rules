rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Truthle daily attempts remain client-created once per user and day.
    match /truthle/daily/{date}/{odp} {
      allow create: if isOwner(odp)
                    && !exists(/databases/$(database)/documents/truthle/daily/$(date)/$(odp));
      allow read: if isOwner(odp);
      allow update, delete: if false;
    }

    // Aggregate daily stats are readable to signed-in players and server-owned.
    match /truthle/stats/{date} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Retry history is written by saveTruthleRetryAttempt and is read-only to its owner.
    match /users/{userId}/truthle_retries/{date} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Cloud wallet balances move only through claimTruthleWallet or server credits.
    match /users/{userId}/wallet/{document=**} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Profile data remains user-owned for the existing account flow.
    match /users/{userId}/profile/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Entitlements and redemptions are server-owned records.
    match /truthle_retry_entitlements/{document=**} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /redemptions/{document=**} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Reminder opt-in accepts only user-editable fields. Provider state, token hashes and
    // unsubscribe metadata can only be changed by Cloud Functions with Admin SDK access.
    match /email_subscribers/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasAll(['email', 'enabled', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(['email', 'displayName', 'enabled', 'updatedAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.enabled is bool
                    && request.resource.data.updatedAt == request.time
                    && (!('displayName' in request.resource.data)
                        || request.resource.data.displayName == null
                        || request.resource.data.displayName is string);
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['email', 'displayName', 'enabled', 'updatedAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.enabled is bool
                    && request.resource.data.updatedAt == request.time
                    && (!('displayName' in request.resource.data)
                        || request.resource.data.displayName == null
                        || request.resource.data.displayName is string);
      allow delete: if false;
    }

    match /email_templates/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Commerce, entitlement, message, and unsubscribe ledgers are server-only.
    match /offertoro_postbacks/{document=**} {
      allow read, write: if false;
    }
    match /ad_reward_events/{document=**} {
      allow read, write: if false;
    }
    match /truthle_paid_retries/{document=**} {
      allow read, write: if false;
    }
    match /truthle_retry_receipts/{document=**} {
      allow read, write: if false;
    }
    match /truthle_retry_usage/{document=**} {
      allow read, write: if false;
    }
    match /wallet_claim_receipts/{document=**} {
      allow read, write: if false;
    }
    match /stripe_retry_grants/{document=**} {
      allow read, write: if false;
    }
    match /stripe_checkout_sessions/{document=**} {
      allow read, write: if false;
    }
    match /truthle_share_promos/{document=**} {
      allow read, write: if false;
    }
    match /truthle_share_claims/{document=**} {
      allow read, write: if false;
    }
    match /mail/{document=**} {
      allow read, write: if false;
    }
    match /mail_delivery_receipts/{document=**} {
      allow read, write: if false;
    }
    match /email_unsubscribe_tokens/{document=**} {
      allow read, write: if false;
    }
  }
}
